# Hourly re-check of pairs whose latest top-of-book cost is near parity —
# a small set, ~2 minutes, catching intraday dislocations between sweeps.

[Unit]
Description=karb — hot-tier re-check (hourly at :30)

[Timer]
OnCalendar=*-*-* *:30:00 UTC

# No Persistent=. This job is about prices right now; running a missed one at
# boot would burn API calls to answer a question that has expired.
Persistent=false

# Decorrelates this from karb-job@sports.timer, which is also due at 07:30, and
# keeps 24 identical requests a day off the same second of the clock.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
